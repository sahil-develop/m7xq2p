# Copy to .env. All values are optional for `docker compose up`; defaults suit local use.
POSTGRES_DB=wind_insights
POSTGRES_USER=wind_insights
POSTGRES_PASSWORD=replace-with-a-local-password

# Only needed when running the API outside Docker (compose sets these itself).
# DATABASE_URL=postgresql+psycopg://wind_insights:replace-with-a-local-password@localhost:5432/wind_insights
# REDIS_URL=redis://localhost:6379/0

ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Only needed if the frontend is served from a different origin than the API (e.g. Vite dev).
CORS_ORIGINS=http://localhost:5173
# Bearer token for POST /api/v1/ingestion/sync. Leave empty to disable the endpoint.
INGESTION_TOKEN=
